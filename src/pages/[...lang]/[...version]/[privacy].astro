
---
import Layout from '../../../layouts/Legal.astro';
import { getAllTranslatedPaths } from '../../../i18n/utils';
import { VERSIONS, CURRENT_VERSION } from '../../../version.config';
import { DEFAULT_LOCALE } from '../../../i18n/config';
import DefaultSection from '../../../components/sections/DefaultSection.astro';
import { getEntry, render } from 'astro:content';
import { getSections, getMenu } from '../../../utilities/sections';
import type { Lang } from '../../../i18n/config';
import WithMapSection from '../../../components/sections/DirectionsSection.astro';
import TracksSection from '../../../components/sections/TracksSection.astro';
import ContactSection from '../../../components/sections/ContactSection.astro';
import TopSection from '../../../components/sections/TopSection.astro';
import RegistrySection from '../../../components/sections/RegistrySection.astro';
import { AstroError } from 'astro/errors';

type ContentData = {
  title: string;  
};

  	
export async function getStaticPaths() {
  return [
    {
      params: {
        lang: "",
        version: "2026",
        privacy: "polityka-prywatnosci",
      },
    },
    {
      params: {
        lang: "en",
        version: "2026",
        privacy: "privacy-policy",
      },
    },
    {
      params: {
        lang: "cs",
        version: "2026",
        privacy: "ochrana-soukromi",
      },
    },
  ];
}

const lang = Astro.currentLocale as Lang;

const slug = `v2026/privacy/${lang}`;
const entry = await getEntry("version", slug);

if (!entry) {
  throw new AstroError(`No content found for slug=${slug}`);
}

const title = (entry.data as ContentData).title;

const { Content } = await render(entry);

---


<Layout
	title={title}	
>
	<Content/>
</Layout>
