---
import BaseLayout from './Base.astro';

interface Props {
    title?: string;
}

const { title } = Astro.props;
---
<BaseLayout>
	<style>			
		.prose {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: auto;						
		}	
	</style>		
	<div class="prose pt-10 pb-4">
		<div class="title">				
			<h2>{title}</h2>
			<hr />
		</div>
		<slot />
	</div>	
</BaseLayout>
