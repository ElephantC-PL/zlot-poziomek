---

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { Lang } from '../i18n/config';
import "../assets/app.css";
import MenuDrawer from '../components/MenuDrawer.astro';
import PrivacyConsentModal from '../components/PrivacyConsentModal.astro';

const lang = Astro.currentLocale as Lang;
---

<html lang={lang} data-theme="night">
	<head>
		<BaseHead />		
	</head>

	<body>
		<MenuDrawer>
			<Header/>				
			<main class="pt-16 pb-8">				
				<slot/>
				<button class="btn" onclick="privacy_consent_modal.showModal()">open modal</button>
				<PrivacyConsentModal/>
			</main>
			<Footer />
			<!-- <CookieConsent/> -->
		</MenuDrawer>
	</body>
	<script>
		import { initScrollSpy } from "../scripts/scrollSpy.ts";
		import { initThemeManager } from "../scripts/theme.js";
		import { initPrivacySettings } from '../scripts/privacySettings.ts';
   		
		initScrollSpy();
		initThemeManager();
		initPrivacySettings();
	</script>
</html>
