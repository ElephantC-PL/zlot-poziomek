---
import type { Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";
import BasicSection from "../../layouts/BasicSection.astro";
import MapIframe from "../MapIframe.astro";
import { marked } from 'marked';

const { data, isLast, isEven } = Astro.props;
const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);

type dayType = {
    name: string;
    routes: routesType[]
};

type routesType = {
    desc?: string;
    map?: string;
    link?: string;
    gpx?: string;
}
---

<BasicSection sectionType={data.type} isLast={isLast}>
    <h2 class="text-center text-primary">{t('section.' + data.type)}</h2>
    <div>        
        <slot />
    </div>
    {data.days && data.days.map((day: dayType) =>(
        <h3>{day.name}:</h3>      
        <div>
            {day.routes.map((route: routesType) => (
               <div class={"flex flex-col md:gap-10 items-center md:flex-row" + (isEven ? "-reverse" : "")}>
                    {route.desc && 
                        <div class={route.map && route.desc ? "md:w-1/2" : "w-full"}>                                                  
                            <Fragment set:html={marked.parse(route.desc)}/>
                        </div>
                    }
                    {route.map && 
                        <div class={(route.map && route.desc ? "md:w-1/2" : "w-full") +" flex justify-center "}>
                            <MapIframe url={route.map} />
                        </div>
                    }
                </div>     
            //  <div>                
            //     {route.map && <MapIframe url={route.map} />} 
            //     {route.link && <a href={route.link} target="_blank">{route.link}</a>}
            //     {route.gpx && <a href={route.gpx} download={route.gpx.split("/").pop()}>{t('sectionsFragments.getGpxFile')}</a>}
            // </div>  
         ))}     
        </div>
    ))} 
</BasicSection>